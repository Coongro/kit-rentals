{
  "id": "kit-rentals",
  "version": "0.3.0",
  "apiVersion": "2.0",
  "displayName": "Alquileres",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [],
    "views": [],
    "repositories": [],
    "menuSections": [
      { "id": "patrimonio", "label": "Patrimonio", "order": 10 },
      { "id": "alquileres", "label": "Alquileres", "order": 20 },
      { "id": "cobranza", "label": "Cobranza", "order": 30 },
      { "id": "operacion", "label": "Operación", "order": 40 }
    ],
    "menuAssignments": [
      {
        "pluginId": "@coongro/leases",
        "path": "Panel",
        "section": "principal",
        "order": 10
      },
      {
        "pluginId": "@coongro/properties",
        "path": "Propiedades",
        "section": "patrimonio",
        "order": 10
      },
      {
        "pluginId": "@coongro/properties",
        "path": "Propietarios",
        "section": "patrimonio",
        "order": 20
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Resultado",
        "section": "patrimonio",
        "order": 30
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Inquilinos",
        "section": "alquileres",
        "order": 10
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Contratos",
        "section": "alquileres",
        "order": 20
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Cobranzas",
        "section": "cobranza",
        "order": 10
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Actualizaciones",
        "section": "cobranza",
        "order": 20
      },
      { "pluginId": "@coongro/billing", "path": "Cobros", "hidden": true },
      { "pluginId": "@coongro/billing", "path": "Caja", "hidden": true },
      {
        "pluginId": "@coongro/maintenance",
        "path": "Mantenimiento",
        "section": "operacion",
        "order": 10
      },
      {
        "pluginId": "@coongro/leases",
        "path": "Vencimientos",
        "section": "operacion",
        "order": 20
      },
      {
        "pluginId": "@coongro/indices",
        "path": "Índices",
        "section": "cobranza",
        "order": 30
      }
    ],
    "copilotCapabilities": [],
    "roles": [
      {
        "key": "operacion",
        "label": "Operación completa",
        "description": "Usa todo el sistema de alquileres: propiedades, contratos, cobranzas y mantenimiento. No administra usuarios ni plugins.",
        "permissions": [
          "leases.adjustments.delete",
          "leases.adjustments.manage",
          "leases.adjustments.read",
          "leases.billing.manage",
          "leases.billing.read",
          "leases.charges.delete",
          "leases.charges.manage",
          "leases.charges.read",
          "leases.contracts.delete",
          "leases.contracts.manage",
          "leases.contracts.read",
          "leases.coTenants.delete",
          "leases.coTenants.manage",
          "leases.coTenants.read",
          "leases.expiries.manage",
          "leases.expiries.read",
          "leases.guarantees.delete",
          "leases.guarantees.manage",
          "leases.guarantees.read",
          "properties.buildingExpenses.delete",
          "properties.buildingExpenses.manage",
          "properties.buildingExpenses.read",
          "properties.buildings.delete",
          "properties.buildings.manage",
          "properties.buildings.read",
          "properties.certificates.delete",
          "properties.certificates.manage",
          "properties.certificates.read",
          "properties.unitOwners.delete",
          "properties.unitOwners.manage",
          "properties.unitOwners.read",
          "properties.units.delete",
          "properties.units.manage",
          "properties.units.read",
          "indices.fx.read",
          "indices.values.delete",
          "indices.values.manage",
          "indices.values.read",
          "maintenance.workOrders.delete",
          "maintenance.workOrders.manage",
          "maintenance.workOrders.read",
          "billing.accounts.delete",
          "billing.accounts.manage",
          "billing.accounts.read",
          "billing.cashCloses.delete",
          "billing.cashCloses.manage",
          "billing.cashCloses.read",
          "billing.lines.delete",
          "billing.lines.manage",
          "billing.lines.read",
          "billing.payments.delete",
          "billing.payments.manage",
          "billing.payments.read",
          "contacts.delete",
          "contacts.manage",
          "contacts.read"
        ],
        "default": true
      },
      {
        "key": "consulta",
        "label": "Consulta",
        "description": "Ve todo el sistema sin poder cambiar nada.",
        "permissions": [
          "leases.adjustments.read",
          "leases.billing.read",
          "leases.charges.read",
          "leases.contracts.read",
          "leases.coTenants.read",
          "leases.expiries.read",
          "leases.guarantees.read",
          "properties.buildingExpenses.read",
          "properties.buildings.read",
          "properties.certificates.read",
          "properties.unitOwners.read",
          "properties.units.read",
          "indices.fx.read",
          "indices.values.read",
          "maintenance.workOrders.read",
          "billing.accounts.read",
          "billing.cashCloses.read",
          "billing.lines.read",
          "billing.payments.read",
          "contacts.read"
        ]
      },
      {
        "key": "cobranzas",
        "label": "Cobranzas",
        "description": "Cobra alquileres, registra pagos y cierra la caja. Ve todo lo demás sin modificarlo.",
        "implies": ["consulta"],
        "permissions": [
          "leases.billing.manage",
          "billing.accounts.manage",
          "billing.lines.manage",
          "billing.payments.manage",
          "billing.cashCloses.manage"
        ]
      },
      {
        "key": "mantenimiento",
        "label": "Mantenimiento",
        "description": "Gestiona las órdenes de trabajo de las propiedades. No ve contratos ni cobranzas.",
        "permissions": ["maintenance.workOrders.manage"]
      }
    ]
  }
}
